{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_API_URL": "https://tickerbrief-api.onrender.com" },
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_API_URL": "https://tickerbrief-api.onrender.com" },
      "ios": { "simulator": false }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "env": { "EXPO_PUBLIC_API_URL": "https://tickerbrief-api.onrender.com" },
      "ios": { "simulator": false }
    }
  },
  "submit": { "production": {} }
}
